  "files": ["src", "gem2codex/src", "gem2codex/package.json", "gem2codex/README.md", "gem2codex/LICENSE", "claude2codex/src", "claude2codex/package.json", "claude2codex/README.md", "glm2codex/src", "glm2codex/package.json", "glm2codex/README.md", "README.md", "CHANGELOG.md", "LICENSE"],
